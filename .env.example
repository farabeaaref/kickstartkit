# ---------------------------------------------------------------------------
# KickstartKit environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser — never put secrets in them.
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Milestone 1)
# Local values are printed by `npm run db:start` (or `npx supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Anon / publishable key — safe for the browser, all access is governed by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role / secret key — SERVER ONLY. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude (Milestone 3)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Resend (Milestone 5)
RESEND_API_KEY=
EMAIL_FROM="KickstartKit <onboarding@yourdomain.com>"

# Scheduled reminders (Milestone 5) — Vercel Cron sends this as a Bearer token.
CRON_SECRET=

# Stripe (Milestone 6)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_AGENCY=

# PostHog (Milestone 7)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry (Milestone 7)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
